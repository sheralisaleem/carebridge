# Copy to .env and fill in. Never commit .env.

# ---- LLM ------------------------------------------------------------------
LLM_PROVIDER=anthropic            # anthropic | openai (any OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5     # override the default model if you like

# OpenAI-compatible alternatives (set LLM_PROVIDER=openai):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1                             # Groq
# OPENAI_BASE_URL=http://localhost:11434/v1                                  # Ollama (local)
# LLM_MODEL=gemini-2.5-flash

# LLM_MAX_TOKENS=4096            # raise for 'thinking' models
# LLM_RETRIES=5
# LLM_MIN_INTERVAL=7              # seconds between LLM calls; use on free tiers with low requests/minute
# LLM_TEMPERATURE=0.2             # optional; omitted from requests when unset

# ---- RAG ------------------------------------------------------------------
EMBEDDING_BACKEND=chroma-default  # chroma-default | sentence-transformers | hash (offline, tests only)
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.25              # similarity below this = "no evidence"

# ---- Simulation -----------------------------------------------------------
# CLINIC_NOW=2026-11-09T15:00     # the simulated clinic clock (keeps the demo reproducible)

# ---- Website accounts -----------------------------------------------------
# SITE_ORIGIN=http://127.0.0.1:8000
# DEMO_DOCTOR_SIGNUP=1             # loopback only
# SIMULATION_ENABLED=0             # disable shared-world change events when hosting
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=accounts@example.com
# SMTP_STARTTLS=1
